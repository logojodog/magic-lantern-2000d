# Film OS module for 2000D / T7 (LiveView-only, optimized shelf)
MODULE_NAME = filmos
TOP_DIR = ../..

FILMOS_PLATFORM ?= 2000D.121
FILMOS_MODEL = $(firstword $(subst ., ,$(FILMOS_PLATFORM)))
FILMOS_FW = $(lastword $(subst ., ,$(FILMOS_PLATFORM)))

# libgcc provides __powisf2 etc. used by film-math
LIBGCC_A := $(shell arm-none-eabi-gcc -print-libgcc-file-name)

MODULE_OBJS = \
	filmroll.o fos_gfx.o fos_film.o fos_ui.o fos_shelf.o fos_pages.o \
	fos_hud.o fos_print.o fos_dark.o fos_dev.o fos_lab.o fos_looks.o fos_jpeg.o \
	fos-libm.a $(LIBGCC_A)

MODULE_CFLAGS += \
	-I. \
	-I$(TOP_DIR)/platform/$(FILMOS_PLATFORM) \
	-I$(TOP_DIR)/platform/$(FILMOS_PLATFORM)/include \
	-I$(TOP_DIR)/src \
	-DCONFIG_$(FILMOS_MODEL)=1 \
	-DCONFIG_$(FILMOS_MODEL)_$(FILMOS_FW)=1 \
	-DCONFIG_FW_VERSION=$(FILMOS_FW) \
	-DFOS_LV_ONLY=1

PYTHON = python3

include ../Makefile.modules

# Prefer the .mo; dep check is advisory for this early port
.DEFAULT_GOAL := $(MODULE_OUTPUT)

fos-libm.a: $(TOP_DIR)/src/libs/arm-none-eabi-O3/libm.a
	$(OBJCOPY) --redefine-sym __errno=fos_errno $< $@
